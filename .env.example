# Copy this file to `.env` (in the repo root) and fill in the values for your
# machine. `.env` is gitignored and should never be committed.

# ==== HuggingFace ====
# Read token used once by `utils-download-uni2-h.py` to download the UNI2-H
# model weights. MahmoodLab/UNI2-h is a GATED model on HuggingFace: you must
# request access on its model page (https://huggingface.co/MahmoodLab/UNI2-h)
# and be approved before this token will work. `HF_READ_TOKEN` is also
# accepted as an alias.
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ==== LDO prostate dataset column names ====
WSI_ID_COL="BiopsyID"
PATIENT_ID_COL="PatientID"

# ==== Logging ====
# Root directory for dated log files, namespaced per pipeline as
# GLOBAL_LOG_DIR/<ProMNIST|camelyon16|LDO-Prostate>/<timestamp> <script>.log
GLOBAL_LOG_DIR="./experiments/logs"

# ==== Outputs / config ====
# Generated JSON configs (feature lists, train/test ID splits) for the LDO
# pipeline. Written by utils-ldo-feature-selection.py, read by
# experiment-ldo-abmilite-training.py.
CONFIG_DIR="./experiments/config"
# Root directory for generated artifacts (figures, checkpoints, result CSVs),
# namespaced per pipeline as OUTPUTS_DIR/<ProMNIST|camelyon16|LDO-Prostate>/...
OUTPUTS_DIR="./experiments/outputs"
# Root of the LDO patient-level data, i.e. the folder containing "Tensors/"
# and "clinical_deidentified_filtered.csv" from the Zenodo download.
TRAINING_DATA_DIR="./data/Tensors"

# ==== Training ====
SEED="2380"
# "cuda" or "cpu"
ACCELERATION_DEVICE="cuda"

# ==== CAMELYON16 / UNI2-H ====
# Directory of per-slide UNI2-H embedding .pt files, produced by
# utils-uni2-embedding.py, consumed by experiment-uni2-camelyon16-abmil.py
# and experiment-camelyon-uncertainty.py.
CAMELYON16_EMBEDS_DIR="./data/camelyon16/embeddings"
